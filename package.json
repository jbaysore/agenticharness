{
  "name": "agentic-harness",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-node-pty.mjs",
    "prebuild": "node scripts/patch-node-pty.mjs --check",
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:attachments": "npm run build && node scripts/attachments-acceptance.mjs",
    "test:directory": "npm run build && node scripts/directory-acceptance.mjs",
    "test:performance": "npm run build && node scripts/performance-acceptance.mjs",
    "perf:workspace": "node scripts/performance-workspace.mjs",
    "test:directoryless": "npm run build && node scripts/directoryless-acceptance.mjs",
    "test:codex-commands": "node scripts/codex-command-acceptance.mjs",
    "test:layout": "npm run build && node scripts/layout-acceptance.mjs",
    "test:list-copy": "npm run build && node scripts/list-copy-acceptance.mjs",
    "test:mobile": "npm run build && node scripts/mobile-acceptance.mjs",
    "test:terminal": "npm run build && node scripts/terminal-acceptance.mjs",
    "test:hidden-consoles": "node scripts/hidden-console-acceptance.mjs",
    "test:scroll": "npm run build && node scripts/scroll-acceptance.mjs",
    "test:models": "npm run build && node scripts/model-picker-acceptance.mjs",
    "test:openrouter": "npm run build && node scripts/openrouter-acceptance.mjs",
    "test:history": "npm run build && node scripts/history-settings-acceptance.mjs",
    "test:turn-sound": "npm run build && node scripts/turn-sound-acceptance.mjs",
    "test:self-restart": "npm run build && node scripts/self-restart-acceptance.mjs",
    "test:permissions": "npm run build && node scripts/permissions-acceptance.mjs",
    "test:questions": "npm run build && node scripts/questions-acceptance.mjs",
    "test:interface": "npm run build && node scripts/interface-acceptance.mjs",
    "test:usage-stop": "npm run build && node scripts/usage-stop-acceptance.mjs",
    "test:watchers": "npm run build && node scripts/watchers-acceptance.mjs",
    "test:goal-progress": "npm run build && node scripts/goal-progress-acceptance.mjs",
    "test:context": "npm run build && node scripts/context-acceptance.mjs",
    "test:compaction": "npm run build && node scripts/compaction-cursor-acceptance.mjs",
    "test:modes": "npm run build && node scripts/mode-suggestions-acceptance.mjs",
    "test:reviewer": "npm run build && node scripts/cursor-review-acceptance.mjs",
    "test:reviewer-settings": "npm run build && node scripts/reviewer-settings-acceptance.mjs",
    "preview:design": "npm run build && node scripts/design-preview.mjs",
    "probe:codex": "node scripts/probe-codex.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@playwright/mcp": "^0.0.83",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "node-pty": "1.1.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9"
  }
}
